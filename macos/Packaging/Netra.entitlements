<!--
  Netra.app entitlements. Not Mac App Store: App Sandbox is off so launch can read
  ~/.netra (same files as netractl) and connect without a one-shot folder grant.
  Hardened runtime still applied by build-app.sh.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <false/>
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
