<!--
  Info.plist for the Netra app bundle. A SwiftPM executable has none, so the netra:// URL scheme,
  Handoff and Spotlight need it embedded, either:
    * in an .app bundle:  Netra.app/Contents/Info.plist (copy this file there, next to Contents/MacOS/Netra), or
    * in the bare binary: add linker flags  -Xlinker -sectcreate -Xlinker __TEXT -Xlinker __info_plist -Xlinker Packaging/Info.plist
      (only the bundle form gets a bundle identifier for Spotlight; the app skips Spotlight when there is none).
  Signing and notarization are done separately and are not part of this file.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>dev.zyvor.netra</string>
  <key>CFBundleName</key><string>Netra</string>
  <key>CFBundleExecutable</key><string>Netra</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.1.0</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>LSMinimumSystemVersion</key><string>15.0</string>
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key><string>dev.zyvor.netra.link</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>CFBundleURLSchemes</key>
      <array><string>netra</string></array>
    </dict>
  </array>
  <key>NSUserActivityTypes</key>
  <array><string>dev.zyvor.netra.section</string></array>
</dict>
</plist>
